// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid())
  created_at        DateTime         @default(now())
  updated_at        DateTime         @default(now())
  name              String
  email             String           @unique
  lastname          String
  username          String           @unique
  avatar            String?
  email_verified_at String?
  remember_me_token String?
  is_activated      Boolean          @default(false)
  password          String
  UserRole          UserRole[]
  UserPermission    UserPermission[]
  UserCompany       UserCompany[]
  Company           Company[]

  @@map("users")
}

model Role {
  id         String     @id @default(uuid())
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now())
  role       String     @unique @default("default")
  UserRole   UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId     String

  @@map("user_roles")
}

model Permission {
  id             String           @id @default(uuid())
  created_at     DateTime         @default(now())
  updated_at     DateTime         @default(now())
  permission     String           @unique()
  UserPermission UserPermission[]

  @@map("permission")
}

model UserPermission {
  id           String     @id @default(uuid())
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId       String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  companyId    String
  permissionId String

  @@map("user_permission")
}

model Company {
  id             String           @id @default(uuid())
  created_at     DateTime         @default(now())
  updated_at     DateTime         @default(now())
  name           String
  user           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId        String
  UserCompany    UserCompany[]
  Equipament     Equipament[]
  UserPermission UserPermission[]
  CompanyArea    CompanyArea[]

  @@map("company")
}

model UserCompany {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  companyId  String

  @@map("user_company")
}

model CompanyArea {
  id         String       @id @default(uuid())
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now())
  company    Company      @relation(fields: [companyId], references: [id])
  companyId  String
  name       String
  Equipament Equipament[]

  @@map("company_area")
}

model Equipament {
  id                   String                 @id @default(uuid())
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now())
  name                 String?
  hardwareId           String?
  posX                 Int                    @default(0)
  posY                 Int                    @default(0)
  company              Company                @relation(fields: [companyId], references: [id])
  companyId            String
  companyArea          CompanyArea            @relation(fields: [companyAreaId], references: [id])
  companyAreaId        String
  EquipamentParameters EquipamentParameters[]

  @@map("equipament")
}

model EquipamentParameters {
  id           String     @id @default(uuid())
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now())
  equipament   Equipament @relation(fields: [equipamentId], references: [id])
  equipamentId String
  name         String
  value        String
  type         String

  @@map("equipament_parameters")
}
